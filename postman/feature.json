				{
					"name": "Create Comment - Unpublished Event",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Ensure event 2 exists and is in PENDING state (not published)",
									"// First, try to reject it to make sure it's not published",
									"var rejectRequest = {",
									"    url: pm.environment.get(\"baseUrl\") + \"/admin/events/\" + pm.environment.get(\"unpublishedEventId\"),",
									"    method: 'PATCH',",
									"    header: {",
									"        'Content-Type': 'application/json'",
									"    },",
									"    body: {",
									"        mode: 'raw',",
									"        raw: JSON.stringify({",
									"            stateAction: 'REJECT_EVENT'",
									"        })",
									"    }",
									"};",
									"",
									"pm.sendRequest(rejectRequest, function (err, res) {",
									"    // Ignore errors - event might not exist or already be in correct state",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 409\", function () {",
									"    pm.response.to.have.status(409);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"Comment on unpublished event\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/{{userId}}/comments/events/{{unpublishedEventId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"{{userId}}",
								"comments",
								"events",
								"{{unpublishedEventId}}"
							]
						},
						"description": "Try to comment on unpublished event - should return 409"
					},
					"response": []
				},
